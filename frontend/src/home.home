
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Eco Mart - Home</title>
  <link rel="stylesheet" href="style.css" />
</head>
<body>
  <!-- Navigation Bar -->
  <header>
    <nav class="navbar">
      <div class="logo">Eco<span>Mart</span></div>
      <ul class="nav-links">
        <li><a href="#">Home</a></li>
        <li><a href="#about">About</a></li>
        <li><a href="#features">Features</a></li>
        <li><a href="#contact">Contact</a></li>
        <li><a href="index.html" class="login-btn">Login</a></li>
      </ul>
    </nav>
  </header>

  <!-- Hero Section -->
  <section class="hero">
    <div class="hero-text">
      <h1>Eco Mart</h1>
      <h2>Reuse. Recycle. Resell. 🌱</h2>
      <p>Buy & Sell reusable college items — books, gadgets, clothes & more! Support campus sustainability and save money.</p>
      <a href="index.html" class="hero-btn">Get Started</a>
    </div>
    <div class="hero-image">
      <img src="eco-image.jpg" alt="Eco Friendly Products" />
    </div>
  </section>
</body>
</html>
